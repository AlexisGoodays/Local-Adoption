# Copie ce fichier en `.snowflake.env` et remplis les valeurs.
# Auth par défaut : SSO navigateur (externalbrowser) — aucune clé ni mot de passe
# à stocker, une fenêtre de connexion s'ouvre au premier appel.
#
#   cp .snowflake.env.example .snowflake.env

# Identifiant de compte, visible dans l'URL que tu utilises déjà pour Snowflake :
# https://app.snowflake.com/<region>/<ACCOUNT>/  ->  format "xxxxxxx-yyxxxxx"
SNOWFLAKE_ACCOUNT=

# Ton login Snowflake (en SSO, c'est en général ton email professionnel).
SNOWFLAKE_USER=

# Rôle disposant d'un accès lecture à MARTING_BUSINESS.ANALYTICS
# et d'un droit d'écriture sur REPORTING.ADOPTION.
SNOWFLAKE_ROLE=REPORTER

# Warehouse sur lequel tu as USAGE.
# Attention : le rôle REPORTER n'a pas OPERATE, il ne peut donc pas réveiller un
# warehouse suspendu — les scripts réessaient, mais si l'erreur "No active
# warehouse" persiste, fais tourner une requête depuis l'UI Snowflake d'abord.
SNOWFLAKE_WAREHOUSE=REPORTING

# Base et schéma des tables sources de tracking.
SNOWFLAKE_DATABASE=MARTING_BUSINESS
SNOWFLAKE_SCHEMA=ANALYTICS

# Valeur par défaut, à décommenter seulement pour forcer explicitement.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
